# Database (PostgreSQL di VPS — lihat deploy/vps-setup.sh)
DATABASE_URL=postgresql://user:password@host:port/database

# Autentikasi internal (JWT)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
JWT_TTL=7d

# User login pertama (dipakai npm run seed:admin)
ADMIN_EMAIL=guru@sekolah.sch.id
ADMIN_PASSWORD=ganti-password-minimal-8-karakter

# Upload file (lampiran modul ajar, dokumen kurikulum, foto profil)
# Di VPS arahkan ke direktori persisten, mis. /opt/sipjok/uploads
UPLOAD_MAX_MB=25

# Application Configuration
VITE_APP_NAME=SIPJOK
VITE_APP_VERSION=1.0.0
VITE_API_TIMEOUT=30000

# Runtime Configuration
# development | production (Production otomatis via script start)
NODE_ENV=development
# Allowed CORS origin, kosongkan bila front-end & API satu domain (default)
# CORS_ORIGIN=https://sipjok.sekolah.sch.id

# Port (di VPS di-set oleh systemd: 5000, hanya di-listen localhost)
PORT=5000
